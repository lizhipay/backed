# API base URL. During dev, requests to /api are proxied to this target via vite.config.ts.
# Set VITE_API_BASE_URL to override the client base path (default: /api).
VITE_API_BASE_URL=/api

# Set to "true" to mount the deletable demo module routes and nav. Default: true in dev.
VITE_ENABLE_DEMO=true

# Backend note: production deployments must set MFA_SECRET_ENCRYPTION_KEY on the Go API.
# It must decode to 16, 24, or 32 bytes. Development can derive a local-only key
# from REFRESH_TOKEN_SECRET when MFA_SECRET_ENCRYPTION_KEY is absent.
